  "_source": {
    "title": "尺寸标注坐标集",
    "remarks.text.0": "尺寸标注坐标集存在以下三种 {@link EPCB_PrimitiveDimensionType | 尺寸标注类型}：",
    "remarks.text.1": "① 半径标注",
    "remarks.text.2": "`[x1, y1, x2, y2, x3, y3]`",
    "remarks.text.3": "- `{number}` `x1` - 圆、圆弧上的端点 X",
    "remarks.text.4": "- `{number}` `y1` - 圆、圆弧上的端点 Y",
    "remarks.text.5": "- `{number}` `x2` - 标注线尾部的端点 X",
    "remarks.text.6": "- `{number}` `y2` - 标注线尾部的端点 Y",
    "remarks.text.7": "- `{number}` `x3` - 标注文字的左下端点 X",
    "remarks.text.8": "- `{number}` `y3` - 标注文字的左下端点 Y",
    "remarks.text.9": "② 长度标注",
    "remarks.text.10": "`[x1, y1, x2, y2, x3, y3, x4, y4]`",
    "remarks.text.11": "- `{number}` `x1` - 第一测量端点 X",
    "remarks.text.12": "- `{number}` `y1` - 第一测量端点 Y",
    "remarks.text.13": "- `{number}` `x2` - 第一标注箭头端点 X",
    "remarks.text.14": "- `{number}` `y2` - 第一标注箭头端点 Y",
    "remarks.text.15": "- `{number}` `x3` - 第二标注箭头端点 X",
    "remarks.text.16": "- `{number}` `y3` - 第二标注箭头端点 Y",
    "remarks.text.17": "- `{number}` `x4` - 第二测量端点 X",
    "remarks.text.18": "- `{number}` `y4` - 第二测量端点 Y",
    "remarks.text.19": "③ 角度标注",
    "remarks.text.20": "`[x1, y1, x2, y2, x3, y3]`",
    "remarks.text.21": "- `{number}` `x1` - 第一边端点 X",
    "remarks.text.22": "- `{number}` `y1` - 第一边端点 Y",
    "remarks.text.23": "- `{number}` `x2` - 角度中心 X",
    "remarks.text.24": "- `{number}` `y2` - 角度中心 Y",
    "remarks.text.25": "- `{number}` `x3` - 第二边端点 X",
    "remarks.text.26": "- `{number}` `y3` - 第二边端点 Y"
  },
