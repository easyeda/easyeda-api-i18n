  "_source": {
    "title": "单多边形源数组",
    "remarks.text.0": "单多边形为首尾重合的一条不间断的线所描述的区域，如果首尾不重合将会自动重合。",
    "remarks.text.1": "单多边形的数据格式举例：",
    "remarks.text.2": "`[300, 200, 'L', 400, 200, 'ARC', 400, 220, 15, 'C', 200, 500, 400, 300, 100, 100]`",
    "remarks.text.3": "`['R', 100, 200, 300, 300, 0, 0]`",
    "remarks.text.4": "`['CIRCLE', 100, 200, 5]`",
    "remarks.text.5": "单多边形的数据由以下几种模式组合而成：",
    "remarks.text.6": "① L 直线模式",
    "remarks.text.7": "`x1 y1 L x2 y3 x3 y3 ...`",
    "remarks.text.8": "- `{number}` `x` - 直线点的 X 坐标",
    "remarks.text.9": "- `{number}` `y` - 直线点的 Y 坐标",
    "remarks.text.10": "② ARC/CARC 圆弧模式",
    "remarks.text.11": "`ARC` 为两点交互，`CARC` 为中心圆弧交互",
    "remarks.text.12": "`startX startY ARC arcAngle endX endY`",
    "remarks.text.13": "`startX startY CARC arcAngle endX endY`",
    "remarks.text.14": "- `{number}` `startX` - 起始 X",
    "remarks.text.15": "- `{number}` `startY` - 起始 Y",
    "remarks.text.16": "- `{number}` `arcAngle` - 圆弧角（负值为顺时针旋转；角度制）",
    "remarks.text.17": "- `{number}` `endX` - 终止 X",
    "remarks.text.18": "- `{number}` `endY` - 终止 Y",
    "remarks.text.19": "③ C 三阶贝塞尔模式",
    "remarks.text.20": "`x1 y1 C x2 y2 x3 y3 x4 y4 ...`",
    "remarks.text.21": "- `{number}` `x` - 控制点 X",
    "remarks.text.22": "- `{number}` `y` - 控制点 Y",
    "remarks.text.23": "④ R 矩形模式",
    "remarks.text.24": "`R x y width height rot round`",
    "remarks.text.25": "- `{number}` `x` - 左上点 X",
    "remarks.text.26": "- `{number}` `y` - 左上点 Y",
    "remarks.text.27": "- `{number}` `width` - 宽",
    "remarks.text.28": "- `{number}` `height` - 高",
    "remarks.text.29": "- `{number}` `rotation` - 旋转角度",
    "remarks.text.30": "- `{number}` `round` - 圆角半径",
    "remarks.text.31": "⑤ CIRCLE 圆形模式",
    "remarks.text.32": "`CIRCLE cx cy radius`",
    "remarks.text.33": "- `{number}` `cx` - 中心点 X",
    "remarks.text.34": "- `{number}` `xy` - 中心点 Y",
    "remarks.text.35": "- `{number}` `radius` - 半径"
  },
