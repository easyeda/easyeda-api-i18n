          "key": "example.text.3",
          "prefix": "// "
        },
        {
          "type": "code",
          "content": "await asyncArc.reset();\n"
        },
        {
          "type": "text",
          "key": "example.text.4",
          "prefix": "// "
        },
        {
          "type": "code",
